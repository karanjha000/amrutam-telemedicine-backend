# Base URL for the Amrutam backend.
#
# In `npm run dev`, Vite proxies /api, /graphql and /swagger-ui to the dev
# backend, so the app works with the default below even when the backend is
# unreachable behind the proxy. Point VITE_API_BASE_URL at a remote backend to
# bypass the proxy (e.g. https://api.amrutam.dev).
VITE_API_BASE_URL=http://localhost:8080
