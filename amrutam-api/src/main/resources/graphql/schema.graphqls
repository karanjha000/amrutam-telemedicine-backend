# Amrutam GraphQL schema (spring-graphql).
#
# The `Instant` scalar is coerced via com.amrutam.api.graphql.InstantCoercion
# (serialize = toString, parse = Instant.parse). GraphQL queries resolve into
# plain DTOs (com.amrutam.api.graphql.dto.*) and delegate to the REST service
# layer; no new data access happens here.

scalar Instant

type Query {
    "All doctors (paged; page/size are optional, defaulting to 0/100)."
    doctors(page: Int, size: Int): [Doctor!]!
    "A single doctor by id; null when unknown."
    doctor(id: ID!): Doctor
    "All consultations for an explicit user (owner-scoped alternative)."
    consultations(user: ID!): [Consultation!]!
    "The current caller's consultations (resolved via the JWT principal)."
    myConsultations: [Consultation!]!
}

type Doctor {
    id: ID!
    userId: ID!
    "Display name; null when the linked user row is unknown."
    name: String
    specialization: String
    consultationFee: BigDecimal
    yearsExperience: Int
    bio: String
    avatarUrl: String
    "Average rating; null until there are ratings."
    rating: Float
    totalRatings: Int
    "Availability slots in the next 30 days."
    slots: [Slot!]!
}

type Slot {
    id: ID!
    startAt: Instant!
    endAt: Instant!
}

type Consultation {
    id: ID!
    doctorId: ID!
    scheduledAt: Instant!
    "Status string (PENDING_PAYMENT / PAID / COMPLETED / CANCELLED / NO_SHOW)."
    status: String!
}
