<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.amrutam</groupId>
        <artifactId>amrutam</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amrutam-workers</artifactId>
    <name>amrutam-workers</name>
    <description>Async workers: job processor, booking-saga reconciler, notification sink, audit stream consumer</description>

    <dependencies>
        <!-- Shared kernel. This module NEVER depends on amrutam-api (which in
             turn depends on amrutam-workers): all cross-table access goes through
             plain JdbcTemplate so the dependency graph stays acyclic. -->
        <dependency>
            <groupId>com.amrutam</groupId>
            <artifactId>amrutam-common</artifactId>
        </dependency>

        <!-- web only for the management surface: /workers/health + actuator
             exposure. No business REST controllers live here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC: every table (async_jobs, consultations, payments,
             availability_slots, audit_logs) is accessed with parameterized
             JdbcTemplate SQL, deliberately NOT through amrutam-api's JPA
             entities or repositories. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Observability: Prometheus endpoint on the workers port -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>${micrometer.version}</version>
        </dependency>

        <!-- PostgreSQL driver (runtime); H2 for the test profile only -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests: JUnit 5 + H2 in-memory, no @SpringBootTest full boot needed
             for the JDBC tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.amrutam.workers.AmrutamWorkersApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
